# Файлы для Linux-сервера должны уезжать с LF, иначе bash споткнётся
# о «\r: command not found», а systemd затащит \r внутрь ExecStart.
*.sh text eol=lf
*.service text eol=lf
# в шагах run: | раннер отдаёт содержимое bash'у, и \r превращается
# в «command not found» на каждой строке
*.yml text eol=lf
*.yaml text eol=lf
# \r в конце строки RUN уезжает в саму команду и ломает сборку
Dockerfile text eol=lf
.dockerignore text eol=lf
# Фикстуры скрейпа читаются байтами, и одна из них лежит в windows-1251:
# нормализация переводов строк поменяла бы ровно то, что разбирает тест.
tests/fixtures/scrape/* -text
