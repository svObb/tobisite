{#-
  Каркас страницы черновика.

  Контекст рендера (его собирает engine/render.py, подэтап 5.3):
    preset   — резолвнутый пресет из tokens/presets.yaml:
               id, archetype, mood, radius_px, density,
               palette{paper, ink, accent, accent_ink, accent_on},
               fonts{display{family, gwfh_id, stack}, body{...}},
               space{section_py, flow, measure}
    site     — lang, title, description, assets_base, ui{skip_to_content}
    facts    — белый список фактов лида (NAP, часы, рейтинг) для JSON-LD и футера
    sections — [{id, role, template, slots{}, images{}}] в порядке рецепта

  Пресет применяется инлайн-переменными на <html>; css/source.css маппит их
  в @theme. Один bundle.css обслуживает все превью — переменные единственное,
  что отличает пресеты друг от друга.
-#}
{%- set css_vars = [
  '--paper:' ~ preset.palette.paper,
  '--ink:' ~ preset.palette.ink,
  '--accent:' ~ preset.palette.accent,
  '--accent-ink:' ~ preset.palette.accent_ink,
  '--accent-on:' ~ preset.palette.accent_on,
  '--radius:' ~ preset.radius_px ~ 'px',
  '--display-font:' ~ preset.fonts.display.stack,
  '--body-font:' ~ preset.fonts.body.stack,
  '--section-py:' ~ preset.space.section_py,
  '--flow:' ~ preset.space.flow,
  '--measure:' ~ preset.space.measure,
] | join(';') -%}
<!doctype html>
<html lang="{{ site.lang }}" style="{{ css_vars }}" data-preset="{{ preset.id }}">
<head>
{% include 'base/head.j2' -%}
</head>
<body class="min-h-screen bg-paper font-body text-ink antialiased">
<a href="#main" class="sr-only rounded-preset focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-accent-ink focus:px-4 focus:py-2 focus:text-accent-on">{{ site.ui.skip_to_content }}</a>
<main id="main">
{%- for section in sections if section.role != 'footer' %}
{% include section.template %}
{%- endfor %}
</main>
{%- for section in sections if section.role == 'footer' %}
{% include section.template %}
{%- endfor %}
</body>
</html>
