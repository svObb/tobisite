{%- set s = section.slots -%}
<section id="{{ section.id }}" class="bg-surface py-section">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <h2 class="font-title text-2xl tracking-tight text-balance break-words sm:text-4xl">{{ s.section_title }}</h2>
    <ul class="mt-flow grid gap-flow sm:grid-cols-2 lg:grid-cols-3">
      {%- for item in s.services %}
      <li class="rounded-preset-lg border border-line bg-paper p-6">
        <h3 class="font-title text-lg leading-snug break-words sm:text-xl">{{ item.name }}</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{{ item.blurb }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
