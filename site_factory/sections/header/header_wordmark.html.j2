{#- Текстовый логотип. Не h1 и не h2: шапка стоит до <main> и в иерархию
    заголовков страницы не входит.

    Порядок на узком экране — название, кнопка меню, телефон: телефон стоит
    отдельной строкой под ними, а не над названием. Само меню — в
    base/header_nav.j2, оно одно на обе шапки. -#}
{%- set s = section.slots -%}
<header id="{{ section.id }}" class="border-b border-line bg-paper">
  <div class="flex w-full flex-wrap items-center justify-between gap-x-8 gap-y-3 px-gutter py-4">
    <p class="order-1 font-title text-xl leading-tight tracking-tight break-words sm:text-2xl">{{ s.business_name }}</p>
{% include 'base/header_nav.j2' %}
    <a href="{{ s.phone_href }}" class="order-3 w-full text-base font-medium break-words text-accent-ink underline decoration-line underline-offset-4 sm:text-lg md:w-auto" data-hit="cta_click">{{ s.phone }}</a>
  </div>
</header>
