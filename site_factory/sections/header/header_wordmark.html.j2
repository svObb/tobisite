{#- Текстовый логотип. Не h1 и не h2: шапка стоит до <main> и в иерархию
    заголовков страницы не входит. -#}
{%- set s = section.slots -%}
<header id="{{ section.id }}" class="border-b border-line bg-paper">
  <div class="flex w-full flex-wrap items-baseline justify-between gap-x-8 gap-y-2 px-gutter py-4">
    <p class="font-title text-xl leading-tight tracking-tight break-words sm:text-2xl">{{ s.business_name }}</p>
    <a href="{{ s.phone_href }}" class="text-base font-medium break-words text-accent-ink underline decoration-line underline-offset-4 sm:text-lg" data-hit="cta_click">{{ s.phone }}</a>
  </div>
</header>
