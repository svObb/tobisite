{#- NAP побайтово совпадает с профилем — это проверяет engine/checks/nap.py.
    Ни одно поле здесь не переписывается моделью. -#}
{%- set s = section.slots -%}
<footer id="{{ section.id }}" class="border-t border-line bg-paper py-section">
  <div class="mx-auto grid w-full max-w-6xl gap-flow px-5 sm:px-8 sm:grid-cols-2 lg:grid-cols-3">
    <div>
      <p class="font-title text-lg break-words sm:text-xl">{{ s.business_name }}</p>
      <address class="mt-3 leading-relaxed text-muted not-italic">{{ s.address }}</address>
    </div>
    <div>
      <h2 class="text-xs font-medium tracking-[0.14em] text-accent-ink uppercase">{{ s.contacts_title }}</h2>
      <ul class="mt-3 grid gap-2">
        <li><a href="{{ s.phone_href }}" class="break-words underline decoration-line underline-offset-4">{{ s.phone }}</a></li>
        {%- if s.email %}
        <li><a href="mailto:{{ s.email }}" class="break-words underline decoration-line underline-offset-4">{{ s.email }}</a></li>
        {%- endif %}
      </ul>
    </div>
    {%- if s.hours %}
    <div>
      <h2 class="text-xs font-medium tracking-[0.14em] text-accent-ink uppercase">{{ s.hours_title }}</h2>
      <ul class="mt-3 grid gap-2 text-muted">
        {%- for row in s.hours %}
        <li>{{ row }}</li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
  </div>
  <p class="mx-auto mt-flow w-full max-w-6xl px-5 text-sm text-muted sm:px-8">{{ s.legal_line }}</p>
</footer>
