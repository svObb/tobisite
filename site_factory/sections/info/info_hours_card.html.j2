{#- Часы и адрес рядом: это две половины одного ответа на вопрос «когда и
    куда приходить». Пустая ячейка времени — строка часов, которая не режется
    по «: »; писать в неё нечего.

    Обе половины разложены по сетке поимённо, а не двумя колонками-обёртками:
    у колонок разная высота, и заголовок правой уезжал вниз, оставляя провал
    под таблицей часов. Здесь заголовки стоят в одной строке сетки, содержимое
    — в следующей, и провал остаётся только под той половиной, которая
    действительно короче. -#}
{%- set s = section.slots -%}
{%- set tone = section.get('tone') -%}
<section id="{{ section.id }}" class="py-section"{% if tone %} data-tone="{{ tone }}"{% endif %}>
  <div class="grid w-full gap-x-flow gap-y-4 px-gutter lg:grid-cols-2 lg:grid-rows-[auto_1fr]">
    <h2 class="font-title text-h2 tracking-tight text-balance break-words lg:col-start-1 lg:row-start-1" data-reveal>{{ s.section_title }}</h2>
    <table class="w-full text-left lg:col-start-1 lg:row-start-2">
      <tbody>
        {%- for row in s.hours %}
        <tr class="border-b border-line">
          <th scope="row" class="py-3 pr-6 font-medium break-words">{{ row.day }}</th>
          <td class="py-3 text-right break-words text-muted">{% if row.time %}{{ row.time }}{% endif %}</td>
        </tr>
        {%- endfor %}
      </tbody>
    </table>
    <h2 class="mt-flow font-title text-h2 tracking-tight text-balance break-words lg:mt-0 lg:col-start-2 lg:row-start-1" data-reveal>{{ s.contacts_title }}</h2>
    <dl class="grid gap-5 lg:col-start-2 lg:row-start-2">
      <div>
        <dt class="eyebrow text-muted">{{ s.address_label }}</dt>
        <dd class="mt-1 text-lede break-words">{{ s.address }}</dd>
      </div>
      <div>
        <dt class="sr-only">{{ s.contacts_title }}</dt>
        <dd class="grid gap-2">
          <a href="{{ s.phone_href }}" class="text-lede font-medium break-words text-accent-ink underline decoration-line underline-offset-4" data-hit="cta_click">{{ s.phone }}</a>
          {%- if s.email %}
          <a href="mailto:{{ s.email }}" class="break-words underline decoration-line underline-offset-4">{{ s.email }}</a>
          {%- endif %}
        </dd>
      </div>
    </dl>
  </div>
</section>
