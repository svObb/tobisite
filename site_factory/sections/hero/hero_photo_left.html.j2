{%- set s = section.slots -%}
{%- set portrait = section.images.portrait -%}
<section id="{{ section.id }}" class="border-b border-line bg-paper py-section">
  <div class="mx-auto grid w-full max-w-6xl gap-flow px-5 sm:px-8 lg:grid-cols-2 lg:items-center">
    <figure class="overflow-hidden rounded-preset-lg bg-surface">
      <img src="{{ portrait.src }}" alt="{{ s.portrait_alt }}" width="{{ portrait.width }}" height="{{ portrait.height }}" class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]" loading="eager" decoding="async" fetchpriority="high">
    </figure>
    <div>
      <p class="text-xs font-medium tracking-[0.18em] text-accent-ink uppercase sm:text-sm">{{ s.eyebrow }}</p>
      <h1 class="mt-4 font-title text-3xl leading-[1.12] tracking-tight text-balance break-words sm:text-5xl">{{ s.headline }}</h1>
      <p class="mt-5 max-w-[var(--measure)] text-base leading-relaxed text-muted sm:text-lg">{{ s.lede }}</p>
      <div class="mt-flow flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="{{ s.phone_href }}" class="rounded-preset bg-accent-ink px-6 py-3 text-center font-medium text-accent-on">{{ s.call_label }}</a>
        <span class="text-sm text-muted">{{ s.reassurance }}</span>
      </div>
    </div>
  </div>
</section>
