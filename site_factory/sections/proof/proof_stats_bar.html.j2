{#- Полоса показателей. Иерархия держится на кегле, а не на своей заливке:
    контрастную секцию на странице выбирает композитор (data-tone), и вторая,
    вшитая в разметку, ставила бы рядом две тёмные полосы подряд. -#}
{%- set s = section.slots -%}
{%- set tone = section.get('tone') -%}
<section id="{{ section.id }}" class="py-section"{% if tone %} data-tone="{{ tone }}"{% endif %}>
  <div class="w-full px-gutter">
    <h2 class="eyebrow text-accent-ink" data-reveal>{{ s.section_title }}</h2>
    <dl class="mt-flow grid gap-flow sm:grid-cols-2 lg:grid-cols-4">
      {%- for item in s.stats %}
      <div class="border-t border-line pt-4">
        <dt class="sr-only">{{ item.label }}</dt>
        <dd>
          <span class="block font-title text-h1 leading-none tracking-tight">{{ item.value }}</span>
          <span class="mt-3 block text-sm leading-snug text-muted sm:text-base">{{ item.label }}</span>
        </dd>
      </div>
      {%- endfor %}
    </dl>
    {%- if s.rating_source_note %}
    <p class="mt-flow text-xs text-muted">{{ s.rating_source_note }}</p>
    {%- endif %}
  </div>
</section>
