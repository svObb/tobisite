{#- Полоса идёт от кромки до кромки: бокового поля у неё нет вовсе, и это
    единственная секция, где его нет — снимки здесь работают фоном страницы,
    а не иллюстрацией к тексту.

    Описать чужие фотографии движку нечем, поэтому alt пустой, а полоса
    спрятана от скринридера: она ничего не сообщает сверх соседних секций. -#}
<section id="{{ section.id }}" class="bg-line">
  <ul class="grid grid-cols-3 gap-px">
    {%- for name in ['photo-2', 'photo-3', 'photo-4'] %}
    {%- set photo = section.images[name] %}
    <li class="bg-paper">
      <img src="{{ photo.src }}" alt="" aria-hidden="true" width="{{ photo.width }}" height="{{ photo.height }}" class="aspect-square w-full object-cover sm:aspect-[4/3]" loading="lazy" decoding="async">
    </li>
    {%- endfor %}
  </ul>
</section>
