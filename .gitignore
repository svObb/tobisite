# ---------------------------------------------------------------------------
# Tobisite Handler — Telegram-бот сбора компаний
#
# ВАЖНО, что специально НЕ игнорируется и должно попадать в репозиторий:
#   .env.example            — образец настроек (см. правило-исключение ниже)
#   alembic.ini             — конфиг миграций
#   alembic/versions/*.py   — сами миграции, это часть кода, а не мусор
# ---------------------------------------------------------------------------

# --- Секреты ----------------------------------------------------------------
# В .env лежат BOT_TOKEN, ACCESS_CODE и DATABASE_URL. В репозиторий — никогда.
.env
.env.*
!.env.example

# Ключи и сертификаты, если когда-нибудь появятся рядом
*.pem
*.key
*.pfx

# --- Виртуальное окружение --------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Сборка и упаковка
build/
dist/
*.egg-info/
.eggs/

# Кэши инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/

# --- Логи бота --------------------------------------------------------------
# LOG_FILE из .env, по умолчанию bot.log — пишется в папку проекта
*.log
logs/

# --- Рабочие выгрузки -------------------------------------------------------
# CSV выгружается во временную папку системы и удаляется, но если файл
# всё же окажется в проекте — он не нужен в репозитории
tobisite_*.csv
companies.csv

# Локальные дампы базы
*.dump
*.sqlite3

# --- Редакторы и IDE --------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Claude Code ------------------------------------------------------------
# Общие настройки проекта (.claude/settings.json) можно коммитить,
# личные локальные — нет
.claude/settings.local.json

# --- Windows / OneDrive -----------------------------------------------------
# Проект лежит в OneDrive, поэтому служебные файлы синхронизации тоже сюда
desktop.ini
Desktop.ini
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# --- macOS / Linux ----------------------------------------------------------
.DS_Store
.Spotlight-V100
.Trashes
