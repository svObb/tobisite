# Образец настроек. Скопировать в .env и заполнить.
# Здесь только те переменные, которые реально читает config.py.
# НИКОГДА не вписывать сюда настоящие значения — этот файл идёт в git.

# ==================== TELEGRAM ====================
# токен от @BotFather
BOT_TOKEN=
# твой Telegram ID — узнать у @userinfobot
ADMIN_TG_ID=
# общий код регистрации работников, менять после каждой волны найма
ACCESS_CODE=
# Необязательно. Админ тоже заносит компании, и в статистике по работникам,
# в фильтрах и в CSV он подписан этим именем. По умолчанию «Администратор».
# ADMIN_NAME=
# Второй админ и дальше (6.16): «tg_id|Имя» через запятую, имя необязательно.
# Права те же, что у первого: панель, статусы, начисления, уведомления.
# Пусто — админ один. Работниками они не считаются: в списке «Работники» их
# нет, отключить и удалить их оттуда нельзя.
# EXTRA_ADMINS=123456789|Оля,987654321

# Токен второго бота от @BotFather — только для тестов.
# Читается вместо BOT_TOKEN при запуске `python main.py --test`.
BOT_TEST_TOKEN=

# ==================== БАЗА ====================
# Боевая база — контейнер postgres рядом с ботом, наружу порт не открыт.
# На СЕРВЕРЕ строку подключения задавать не надо: compose.yaml собирает её
# сам из POSTGRES_PASSWORD и подставляет боту. Достаточно пароля:
# POSTGRES_PASSWORD=
#
# Локально (запуск через venv, без контейнеров) — обычная строка:
DATABASE_URL=postgresql+asyncpg://tobisite:ПАРОЛЬ@localhost/tobisite

# ==================== ТОЛЬКО НА СЕРВЕРЕ ====================
# Тег запущенного образа = sha коммита. Проставляется деплоем, руками трогать
# только при первом запуске и при ручном откате. Локально не нужен.
# IMAGE_TAG=

# Тестовая база — отдельный проект в Neon (бесплатный).
# Читается вместо DATABASE_URL при `python main.py --test`.
# Для asyncpg именно ssl=require, а НЕ sslmode=require;
# хост брать POOLED (в имени есть -pooler).
# Совпадение с DATABASE_URL код считает ошибкой и не запускается.
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@host-pooler.region.aws.neon.tech/neondb?ssl=require

# Кэш prepared statements. Через PgBouncer (pooled-хосты Neon и Supabase) его
# надо гасить, при прямом подключении — держать включённым. Определяется сам:
# в pooled-хосте есть слово "pooler". Ставить руками 1/0 нужно только если ваш
# пул назван иначе.
# DB_POOLED=

# ==================== ЛИМИТЫ ====================
# лимит записей в сутки по умолчанию; у работника может быть свой в БД
DEFAULT_DAILY_LIMIT=15
# сколько минут после отправки работник может отменить запись
CANCEL_WINDOW_MIN=60
# Месячный потолок расходов на ИИ и платные API, $ (журнал cost_ledger, /costs).
# При 80% и 100% админ получает алерт; при 100% платные операции останавливаются.
# 0 выключает кэп — не рекомендуется. Решение по бюджету: $100–200/мес.
AI_MONTHLY_CAP_USD=150
# Потолок карточек, которые лид-скаут (/scout) может импортировать за день:
# каждая импортированная карточка = ручная модерация админом.
SCOUT_DAILY_RAW_LIMIT=50

# ==================== ПИСЬМА ====================
# Ключ Anthropic (консоль Anthropic, бюджетный лимит ≤$20/мес). Без него бот
# не генерирует ни писем, ни слотов черновиков: карточка честно уходит в
# ручную ветку. Выдумывать текст вместо модели код не умеет.
# ANTHROPIC_API_KEY=
# Подпись под письмом и юридические строки (Д12 §1).
# SIGNATURE_NAME=Имя Фамилия
# SIGNATURE_COMPANY=tobisite
# ЗАГЛУШКА: настоящий почтовый адрес появится после подключения M365 (5.43).
# Пока он пуст, письма наружу не отправляются вообще, а очередь показывает
# дежурному, чего письму не хватает по CAN-SPAM (9.8).
# POSTAL_ADDRESS=
# Ссылка отписки (9.30): здесь стоит merge-тег рассыльщика, а не URL —
# подставит его Instantly при отправке. Точное написание тега берётся из его
# документации при подключении; в письмо 1 ссылка не идёт никогда (9.1).
# UNSUBSCRIBE_TAG={{unsubscribe_link}}

# ==================== РЫНКИ ====================
# формат: Название|ISO2, через запятую. Порядок = порядок кнопок.
# ISO2 обязателен: по нему местный номер (050 123 45 67) превращается
# в +380501234567. Без кода страны такой номер бот отклонит и попросит
# международный формат — иначе дубликаты телефонов перестают ловиться.
COUNTRIES=Словакия|SK,Украина|UA

# ВНИМАНИЕ: только названия, без кодов языка.
# Код не разбирает здесь символ "|", он попадёт прямо на кнопку.
LANGUAGES=Словацкий,Украинский,Венгерский,Русский,Английский

# ==================== УВЕДОМЛЕНИЯ ====================
# Сообщение админам о каждой новой компании (6.13). 0 выключает — например,
# на время массового заноса, когда поток сообщений перестаёт что-либо значить.
# NOTIFY_NEW_LEAD=1

# ==================== ПРОЧЕЕ ====================
TZ=Europe/Kyiv
LOG_LEVEL=INFO
# Файл лога в папке проекта. На сервере не используется: compose.yaml задаёт
# пустое значение, и лог идёт только в stdout, откуда его забирает docker
# с настроенной ротацией.
LOG_FILE=bot.log
