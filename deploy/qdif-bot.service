[Unit]
Description=qDif Handler — Telegram-бот сбора компаний
Documentation=https://github.com/svObb/qDif-handler
# база локальная, поэтому postgresql должен подняться раньше бота: иначе после
# перезагрузки сервера бот падает на первом подключении и стартует только со
# второй-третьей попытки Restart=always, засоряя журнал
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# без этого systemd сдаётся после 5 падений подряд и бот остаётся лежать
StartLimitIntervalSec=0

[Service]
Type=simple
User=qdif
Group=qdif
WorkingDirectory=/opt/qdif-bot
# без флага --test: боевой токен и боевая ветка базы
ExecStart=/opt/qdif-bot/.venv/bin/python main.py
Restart=always
RestartSec=5

# иначе stdout буферизуется и лог в journal приходит с задержкой
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qdif-bot

# изоляция: боту нужен только исходящий интернет и запись в свою папку
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qdif-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RemoveIPC=true

[Install]
WantedBy=multi-user.target
